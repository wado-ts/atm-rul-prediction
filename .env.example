# Copy this file to `.env` and fill in real values.

APP_NAME="ATM Predictive Maintenance"
ENVIRONMENT=production

# ---- Oracle DB ----------------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=
# python-oracledb DSN, e.g. "myhost.company.com:1521/ATMPROD"
ORACLE_DSN=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
# Table/view holding raw ATM event/journal logs (adjust query in app/database.py
# to match your real column names/schema)
ORACLE_SOURCE_TABLE=
# Rolling window pulled from Oracle on every run
LOOKBACK_DAYS=60

# ---- PostgreSQL ---------------------------------------------------------
# DSN format expected by psycopg, e.g. "postgresql://user:pass@host:5432/dbname"
POSTGRES_DSN=

# ---- CSV Testing ----------------------------------------------------------
# Use "csv" for local/testing runs that should bypass Oracle entirely.
DATA_SOURCE=oracle
CSV_PATH=data/monetary_data.csv
# Fixed reference time for CSV testing (ISO format). Use a date after the last data point.
# Data goes up to 2026-07-28, so use 2026-07-28T23:59:59
CSV_REFERENCE_TIME=2026-07-28T23:59:59

# ---- Sequence-building service -------------------------------------------
SEQUENCE_BUILDER_URL=http://localhost:9001/build-sequences
SEQUENCE_BUILDER_TIMEOUT_SECONDS=30

# ---- Inference service -----------------------------------------------------
INFERENCE_SERVICE_URL=http://localhost:9002/predict-rul
INFERENCE_SERVICE_TIMEOUT_SECONDS=30

# ---- Scheduler ---------------------------------------------------------------
# Daily automatic prediction run time (24h clock, server local time)
DAILY_RUN_HOUR=0
DAILY_RUN_MINUTE=0

# ---- JWT / Auth ----------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:8000
JWT_PRIVATE_KEY_PATH=keys/intel_pub
JWT_PUBLIC_KEY_PATH=keys/intel_pub.pub
JWT_SECRET_KEY=

# ---- Institution sync ----------------------------------------------------
INSTITUTION_SYNC_ENABLED=true
INSTITUTION_SYNC_INTERVAL_MINUTES=1440

# ---- Pagination ----------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ALLOWED_PAGE_SIZES=[10,20,50,100]

# ---- Search --------------------------------------------------------------
SEARCH_DEBOUNCE_MS=300
SEARCH_MIN_LENGTH=1
